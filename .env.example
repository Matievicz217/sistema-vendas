NODE_ENV=development
PORT=3000
SESSION_SECRET=
CODIGO_CADASTRO=
TRUST_PROXY_HOPS=0

# Use apenas durante a criação inicial da conta admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: por padrão, o banco fica em db.sqlite na raiz.
# DATABASE_PATH=C:\caminho\para\db.sqlite

# PostgreSQL: quando definido, substitui o SQLite para dados e sessões.
# No Render, use a Internal Database URL no painel de Environment.
DATABASE_URL=
# Somente para importar uma cópia de segurança do banco antigo:
SQLITE_SOURCE_PATH=

# Ative apenas no primeiro deploy para criar o admin sem Shell.
BOOTSTRAP_ADMIN=false
