NODE_ENV=development
PORT=3000
SESSION_SECRET=
CODIGO_CADASTRO=
TRUST_PROXY_HOPS=0

# Use apenas durante a criação inicial da conta admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Obrigatório: use a URL do seu PostgreSQL local ou hospedado.
# Exemplo: postgresql://usuario:senha@localhost:5432/vendas
# No Render, use a Internal Database URL no painel de Environment.
DATABASE_URL=

# Ative apenas no primeiro deploy para criar o admin sem Shell.
BOOTSTRAP_ADMIN=false
